# HTTP server port
SERVER_PORT=8080

# Logging
LOG_LEVEL=INFO
# Vector forwards JSON logs to Elasticsearch when running outside Docker.
LOG_VECTOR_DESTINATION=localhost:5044
# Defaults to true locally and false in the Docker image. Uncomment to override.
# LOG_VECTOR_ENABLED=true

# Opt in after provisioning notification.commands and configuring the SMTP relay.
NOTIFICATION_KAFKA_ENABLED=false
# Required when enabled; supply your environment's host:port list.
KAFKA_BOOTSTRAP_SERVERS=
# Stable, non-secret logical subscriber identity; keep across restarts/replicas.
KAFKA_CONSUMER_GROUP=vigo-notification-service-v1

# Coach application result emails from user.events. Uses the same Kafka and SMTP settings.
# When enabled, set the NOTIFICATION_DB_* settings below for durable deduplication.
NOTIFICATION_KAFKA_USER_EVENTS_ENABLED=false
NOTIFICATION_KAFKA_USER_EVENTS_GROUP=vigo-notification-service-user-events
NOTIFICATION_REGISTRATION_URL=https://vigoapp.ir/register

# Kafka v2 (isolated synthetic verification only)
NOTIFICATION_KAFKA_V2_ENABLED=false
NOTIFICATION_KAFKA_V2_MODE=
NOTIFICATION_KAFKA_V2_BOOTSTRAP_SERVERS=
NOTIFICATION_KAFKA_V2_GROUP=vigo-notification-service-v2
NOTIFICATION_KAFKA_V2_SYNTHETIC_USER_IDS=

# External SMTP relay. Use STARTTLS with port 587 or TLS with port 465.
# NONE is for a trusted plaintext relay and requires SMTP_AUTH=false.
SMTP_HOST=mail.vigoapp.ir
SMTP_PORT=465
SMTP_SECURITY=TLS
SMTP_AUTH=true
SMTP_USERNAME=info@vigoapp.ir
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=info@vigoapp.ir
SMTP_FROM_NAME=Vigo
SMTP_CONNECT_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# IN_APP REST (opt-in; when enabled, Flyway runs before serving requests).
NOTIFICATION_IN_APP_ENABLED=false
# DB settings are required for IN_APP REST or user.events. Use a dedicated database.
# PostgreSQL defaults to sslmode=disable. Set sslmode=verify-full in the URL for verified TLS.
# URL query parameters are limited to sslmode and sslrootcert. No credentials in URL.
NOTIFICATION_DB_URL=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
# Set explicitly; public is the approved disposable-development convention.
NOTIFICATION_DB_SCHEMA=
# IN_APP REST requires the exact deployed Auth issuer/audience and a trusted HTTPS JWKS endpoint.
NOTIFICATION_JWT_JWKS_URL=
NOTIFICATION_JWT_ISSUER=
NOTIFICATION_JWT_AUDIENCE=
