# HTTP server port
SERVER_PORT=8080

# Logging
LOG_LEVEL=INFO
# Vector forwards JSON logs to Elasticsearch when running outside Docker.
LOG_VECTOR_DESTINATION=localhost:5044
# Defaults to true locally and false in the Docker image. Uncomment to override.
# LOG_VECTOR_ENABLED=true

# Opt in after provisioning notification.commands and configuring the SMTP relay.
NOTIFICATION_KAFKA_ENABLED=false
# Required when enabled; supply your environment's host:port list.
KAFKA_BOOTSTRAP_SERVERS=
# Stable, non-secret logical subscriber identity; keep across restarts/replicas.
KAFKA_CONSUMER_GROUP=vigo-notification-service-v1

# External SMTP relay. Use STARTTLS with port 587 or TLS with port 465.
# NONE is for a trusted plaintext relay and requires SMTP_AUTH=false.
SMTP_HOST=mail.vigoapp.ir
SMTP_PORT=465
SMTP_SECURITY=TLS
SMTP_AUTH=true
SMTP_USERNAME=info@vigoapp.ir
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=info@vigoapp.ir
SMTP_FROM_NAME=Vigo
SMTP_CONNECT_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
