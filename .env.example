# Server
SERVER_PORT=8080
# Kafka
# Opt in only when a broker and notification.commands topic are provisioned.
NOTIFICATION_KAFKA_ENABLED=false
# Required when enabled; supply your environment's host:port list.
KAFKA_BOOTSTRAP_SERVERS=
# Stable, non-secret logical subscriber identity; keep across restarts/replicas.
KAFKA_CONSUMER_GROUP=vigo-notification-service-v1

# Email (opt-in; no SMTP connection or email is sent on startup)
NOTIFICATION_EMAIL_ENABLED=false
# Required when email is enabled; supply deployment values.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_ADDRESS=
# Required when SMTP_AUTH=true.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
# When true, STARTTLS is required, not merely attempted.
SMTP_STARTTLS_ENABLED=true
# Positive millisecond bounds (zero/infinite timeouts are rejected).
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
